# ==========================================
# UK BRAND LOVER — PRODUCTION ENVIRONMENT VARIABLES
# ==========================================
# In Vercel: You can copy & paste this whole file into the 
# Environment Variables box, or import this file directly.

# 1. Platform & Currency
NEXT_PUBLIC_CURRENCY_SYMBOL="৳"
NEXT_PUBLIC_APP_URL="https://ukbrandlover.vercel.app"

# 2. Supabase PostgreSQL Database (Free Tier)
# Replace [YOUR-PROJECT-REF] and [YOUR-PASSWORD] with your Supabase credentials:
# Pooled Connection URL (Port 6543 - for Next.js Serverless runtime):
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection URL (Port 5432 - for Prisma schema migrations):
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# 3. Cloudflare R2 Media Storage (10 GB Free Forever)
# Found in Cloudflare Dashboard -> R2 Storage -> Manage R2 API Tokens:
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="ukbrandlover-media"
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxx.r2.dev"

# 4. Official WhatsApp Integration (+880 1959-524393)
WHATSAPP_HOTLINE="+880 1959-524393"
WHATSAPP_VERIFY_TOKEN="ukbl_verify_secret_2026"

# Optional: Fill these only if you are using Meta WhatsApp Cloud API instead of the Free QR Gateway:
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
