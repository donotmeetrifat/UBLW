# ==========================================
# UK BRAND LOVER — PRODUCTION ENVIRONMENT VARIABLES
# ==========================================
# In Vercel: Copy and paste this whole block into the 
# Environment Variables box.

# 1. Platform & Currency
NEXT_PUBLIC_CURRENCY_SYMBOL="৳"
NEXT_PUBLIC_APP_URL="https://ukbrandlover.vercel.app"

# 2. Supabase Database & 100% Free Storage (NO CARD NEEDED AT ALL)
# From Supabase Dashboard -> Settings -> Database:
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# From Supabase Dashboard -> Settings -> API:
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_BUCKET="products"

# 3. Official WhatsApp Integration (+880 1959-524393)
WHATSAPP_HOTLINE="+880 1959-524393"
WHATSAPP_VERIFY_TOKEN="ukbl_verify_secret_2026"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# 4. (Optional) Cloudflare R2 Media Storage - Only if you have a card later
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
